<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest" 
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10" 
         IgnorableNamespaces="uap mp">
  
  

  <Properties>
    <DisplayName>JamBan Original</DisplayName>
    <PublisherDisplayName>DevelopmentStudio</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Xbox" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22000.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App" Executable="JamBox Original.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="JamBan Original"
                          Square150x150Logo="/workspaces/JamBox-Original/AppFiles/logo.png"
                          Square44x44Logo="/workspaces/JamBox-Original/AppFiles/logo.png"
                          Description="JamBan Original"
                          BackgroundColor="#464646">
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
